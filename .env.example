# 复制为 .env 后按需修改。

AGENT_RUNS_DIR=./data/agent_runs

TIMESERIES_MAX_POINTS=200000
TIMESERIES_MIN_POINTS=3
TIMESERIES_ANOMALY_ZSCORE=3.5
TIMESERIES_CORRELATION_THRESHOLD=0.6

PROFILE_MAX_ROWS=100000
PROFILE_MAX_EXAMPLES=20
SAMPLE_SIZE_WARNING_THRESHOLD=1000

MAX_SCHEMA_FILE_BYTES=2097152
MAX_DATA_FILE_BYTES=536870912
MAX_FOLDER_FILE_COUNT=2000
MAX_FOLDER_TOTAL_BYTES=1073741824

# ---- LLM：为每个资源单独生成统一 JSON ----
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=your-model
LLM_ENABLE_API=true
LLM_REQUIRED=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8192

# ---- 数据库：密码只保存在进程内存，支持 MySQL、PostgreSQL、SQL Server、SQLite、Oracle ----
DATABASE_CONNECTION_TTL_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=8
DATABASE_QUERY_TIMEOUT_SECONDS=30
