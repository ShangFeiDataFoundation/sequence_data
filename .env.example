# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，不会进版本库。

# ---- 小模型 / API（方案 §4.4） ----
# 三项齐全且 SEMANTIC_ENABLE_API 为 true 时调用小模型；
# 否则使用 RuleBasedProvider 规则实现，可完全离线运行。
SEMANTIC_API_BASE=https://api.example.com/v1
SEMANTIC_API_KEY=sk-replace-me
SEMANTIC_MODEL=qwen2.5-7b-instruct
SEMANTIC_ENABLE_API=true
SEMANTIC_TIMEOUT_SECONDS=60

# ---- 增强型 Agent ----
# true: 必须使用云端 API，未配置或初始化失败时 Agent 直接失败
# false: API 不可用时降级为规则提供方
AGENT_REQUIRE_API=false
# 单次运行最多保留的待确认/告警项
AGENT_MAX_REVIEW_ITEMS=500

# 小模型置信度低于该值、或存在多个候选时，字段保留待确认状态（方案 §4.3）
SEMANTIC_CONFIDENCE_THRESHOLD=0.85

# ---- 存储 ----
# 每个批次一个子目录，含上传原件、batch.json 与解析结果
DATA_DIR=./data/batches

# ---- 数据画像（方案 §3.3） ----
# 统计最多读取的行数
PROFILE_MAX_ROWS=100000
# 展示与送模型的脱敏样例最多条数
PROFILE_MAX_EXAMPLES=20
# 真实数据少于该行数时标记 sample_size_warning
SAMPLE_SIZE_WARNING_THRESHOLD=1000

# ---- 上传限制 ----
MAX_SQL_FILE_BYTES=2097152
MAX_DATA_FILE_BYTES=536870912
